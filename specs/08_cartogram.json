{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 580,
 "title": {
  "text": [
   "New South Wales is the biggest destination, but",
   "Queensland grew and the Northern Territory shrank"
  ],
  "subtitle": [
   "Dorling cartogram: circle area = overnight trips, year ending June 2026; circles",
   "sit near each state's real position. Orange = fastest growth and fastest fall in",
   "trips versus June 2025; others grey."
  ],
  "anchor": "start"
 },
 "data": {
  "url": "data/dots_state_dorling.csv"
 },
 "transform": [
  {
   "calculate": "datum.r_px*datum.r_px*4",
   "as": "sz"
  },
  {
   "calculate": "datum.state=='Queensland'||datum.state=='Northern Territory'",
   "as": "hl"
  }
 ],
 "encoding": {
  "x": {
   "field": "x",
   "type": "quantitative",
   "scale": {
    "domain": [
     40,
     480
    ]
   },
   "axis": null
  },
  "y": {
   "field": "y",
   "type": "quantitative",
   "scale": {
    "domain": [
     35,
     415
    ],
    "reverse": true
   },
   "axis": null
  }
 },
 "layer": [
  {
   "mark": {
    "type": "circle",
    "stroke": "#555",
    "strokeWidth": 1,
    "opacity": 0.9
   },
   "encoding": {
    "size": {
     "field": "sz",
     "type": "quantitative",
     "scale": null,
     "legend": null
    },
    "color": {
     "condition": {
      "test": "datum.hl",
      "value": "#e6550d"
     },
     "value": "#bdbdbd"
    },
    "strokeWidth": {
     "condition": {
      "param": "hv",
      "empty": false,
      "value": 3
     },
     "value": 1
    },
    "tooltip": [
     {
      "field": "state",
      "title": "State"
     },
     {
      "field": "trips_000",
      "title": "Trips (thousands)",
      "format": ","
     },
     {
      "field": "change_pct",
      "title": "Change versus June 2025 (%)",
      "format": "+.1f"
     }
    ]
   },
   "params": [
    {
     "name": "hv",
     "select": {
      "type": "point",
      "fields": [
       "state"
      ],
      "on": "mouseover",
      "clear": "mouseout"
     }
    }
   ]
  },
  {
   "transform": [
    {
     "filter": "datum.r_px>50"
    }
   ],
   "mark": {
    "type": "text",
    "fontWeight": "bold",
    "fontSize": 13,
    "color": "#222"
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.state=='Western Australia'"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 13,
    "color": "#222",
    "baseline": "bottom",
    "align": "left",
    "dx": -35,
    "dy": -41
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.state=='South Australia'"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 13,
    "color": "#222",
    "baseline": "bottom",
    "align": "center",
    "dy": -37
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.state=='Northern Territory'"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 13,
    "color": "#222",
    "baseline": "bottom",
    "align": "center",
    "dy": -17
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.state=='Tasmania'"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 13,
    "color": "#222",
    "baseline": "middle",
    "align": "left",
    "dx": 25
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.state=='Australian Capital Territory'"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 13,
    "color": "#222",
    "baseline": "middle",
    "align": "left",
    "dx": 22
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  }
 },
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 }
}