{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": 560,
 "height": 420,
 "title": {
  "text": "NSW is the biggest destination, but Queensland grew and the Northern Territory shrank",
  "subtitle": [
   "Dorling cartogram: circle area = overnight trips, year ending June 2026; circles sit near each state's real position",
   "Orange = fastest growth / fastest fall in trips versus June 2025; others grey"
  ],
  "anchor": "start"
 },
 "data": {
  "url": "data/dots_state_dorling.csv"
 },
 "transform": [
  {
   "calculate": "datum.r_px*datum.r_px*4",
   "as": "sz"
  },
  {
   "calculate": "datum.state=='QLD'||datum.state=='NT'",
   "as": "hl"
  }
 ],
 "params": [
  {
   "name": "hv",
   "select": {
    "type": "point",
    "fields": [
     "state"
    ],
    "on": "mouseover",
    "clear": "mouseout"
   }
  }
 ],
 "encoding": {
  "x": {
   "field": "x",
   "type": "quantitative",
   "scale": {
    "domain": [
     0,
     560
    ]
   },
   "axis": null
  },
  "y": {
   "field": "y",
   "type": "quantitative",
   "scale": {
    "domain": [
     0,
     420
    ],
    "reverse": true
   },
   "axis": null
  }
 },
 "layer": [
  {
   "mark": {
    "type": "circle",
    "stroke": "#555",
    "strokeWidth": 1,
    "opacity": 0.9
   },
   "encoding": {
    "size": {
     "field": "sz",
     "type": "quantitative",
     "scale": null,
     "legend": null
    },
    "color": {
     "condition": {
      "test": "datum.hl",
      "value": "#e6550d"
     },
     "value": "#bdbdbd"
    },
    "strokeWidth": {
     "condition": {
      "param": "hv",
      "empty": false,
      "value": 3
     },
     "value": 1
    },
    "tooltip": [
     {
      "field": "state",
      "title": "State"
     },
     {
      "field": "trips_000",
      "title": "Trips ('000)",
      "format": ","
     },
     {
      "field": "change_pct",
      "title": "Change vs June 2025 (%)",
      "format": "+.1f"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "fontWeight": "bold",
    "fontSize": 12,
    "color": "#222"
   },
   "transform": [
    {
     "filter": "datum.r_px>15"
    }
   ],
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  },
  {
   "mark": {
    "type": "text",
    "fontSize": 11,
    "color": "#222",
    "dy": -22
   },
   "transform": [
    {
     "filter": "datum.r_px<=15"
    }
   ],
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  }
 }
}