{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 360,
 "title": {
  "text": [
   "Queensland grew most, Northern Territory fell most"
  ],
  "subtitle": [
   "Change in overnight trips, year ending June 2026 versus June 2025 (%). Orange =",
   "the biggest rise and the biggest fall."
  ],
  "anchor": "start"
 },
 "data": {
  "url": "data/dots_state_change.csv"
 },
 "transform": [
  {
   "calculate": "datum.code=='QLD'||datum.code=='NT'",
   "as": "hl"
  },
  {
   "calculate": "datum.trips_2026-datum.trips_2025",
   "as": "diff"
  },
  {
   "calculate": "datum.change_pct>=0 ? 'grew' : 'fell'",
   "as": "dir"
  }
 ],
 "layer": [
  {
   "mark": {
    "type": "bar",
    "cursor": "pointer",
    "strokeWidth": 0
   },
   "encoding": {
    "y": {
     "field": "state",
     "type": "nominal",
     "sort": "-x",
     "title": null
    },
    "x": {
     "field": "change_pct",
     "type": "quantitative",
     "title": "Change in trips (%)"
    },
    "color": {
     "condition": {
      "test": "datum.hl",
      "value": "#e6550d"
     },
     "value": "#bdbdbd"
    },
    "opacity": {
     "condition": {
      "param": "hv",
      "empty": true,
      "value": 1
     },
     "value": 0.45
    },
    "strokeWidth": {
     "condition": {
      "param": "hv",
      "empty": false,
      "value": 2
     },
     "value": 0
    },
    "tooltip": [
     {
      "field": "state",
      "type": "nominal",
      "title": "State"
     },
     {
      "field": "change_pct",
      "type": "quantitative",
      "title": "Change versus June 2025 (%)",
      "format": "+.2f"
     },
     {
      "field": "trips_2025",
      "type": "quantitative",
      "title": "Year to June 2025 (thousands of trips)",
      "format": ",.0f"
     },
     {
      "field": "trips_2026",
      "type": "quantitative",
      "title": "Year to June 2026 (thousands of trips)",
      "format": ",.0f"
     },
     {
      "field": "diff",
      "type": "quantitative",
      "title": "Difference (thousands of trips)",
      "format": "+,.0f"
     }
    ]
   },
   "params": [
    {
     "name": "hv",
     "select": {
      "type": "point",
      "on": "mouseover",
      "clear": "mouseout",
      "fields": [
       "state"
      ]
     }
    }
   ]
  },
  {
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 4,
    "fontSize": 13
   },
   "encoding": {
    "y": {
     "field": "state",
     "type": "nominal",
     "sort": "-x"
    },
    "x": {
     "field": "change_pct",
     "type": "quantitative"
    },
    "text": {
     "field": "change_pct",
     "type": "quantitative",
     "format": "+.1f"
    }
   },
   "transform": [
    {
     "filter": "datum.change_pct>=0"
    }
   ]
  },
  {
   "mark": {
    "type": "text",
    "align": "right",
    "dx": -4,
    "fontSize": 13
   },
   "encoding": {
    "y": {
     "field": "state",
     "type": "nominal",
     "sort": "-x"
    },
    "x": {
     "field": "change_pct",
     "type": "quantitative"
    },
    "text": {
     "field": "change_pct",
     "type": "quantitative",
     "format": "+.1f"
    }
   },
   "transform": [
    {
     "filter": "datum.change_pct<0"
    }
   ]
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "grid": false
  }
 }
}