{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 485,
 "title": {
  "text": [
   "Nearly half of all trips are holidays"
  ],
  "subtitle": [
   "Share of overnight trips by reason, year ending June 2026"
  ],
  "anchor": "start"
 },
 "data": {
  "url": "data/dots_reason.csv"
 },
 "layer": [
  {
   "mark": {
    "type": "arc",
    "innerRadius": 112,
    "outerRadius": 212,
    "stroke": "white",
    "strokeWidth": 2
   },
   "encoding": {
    "theta": {
     "field": "trips_000",
     "type": "quantitative",
     "stack": true
    },
    "order": {
     "field": "trips_000",
     "type": "quantitative",
     "sort": "descending"
    },
    "color": {
     "field": "reason",
     "type": "nominal",
     "sort": [
      "Holiday",
      "Visiting friends and relatives",
      "Business",
      "Other"
     ],
     "scale": {
      "domain": [
       "Holiday",
       "Visiting friends and relatives",
       "Business",
       "Other"
      ],
      "range": [
       "#3949ab",
       "#9fa8da",
       "#bdbdbd",
       "#e0e0e0"
      ]
     },
     "legend": {
      "title": null,
      "orient": "bottom",
      "direction": "horizontal",
      "labelFontSize": 13,
      "symbolSize": 140
     }
    },
    "opacity": {
     "condition": {
      "param": "hv",
      "empty": false,
      "value": 1
     },
     "value": 0.9
    },
    "tooltip": [
     {
      "field": "reason",
      "title": "Reason"
     },
     {
      "field": "trips_000",
      "title": "Trips (thousands)",
      "format": ","
     },
     {
      "field": "share",
      "title": "Share (%)"
     }
    ]
   },
   "params": [
    {
     "name": "hv",
     "select": {
      "type": "point",
      "fields": [
       "reason"
      ],
      "on": "mouseover",
      "clear": "mouseout"
     }
    }
   ]
  },
  {
   "mark": {
    "type": "text",
    "radius": 162,
    "fontSize": 16,
    "fontWeight": "bold"
   },
   "transform": [
    {
     "filter": "datum.share>5"
    }
   ],
   "encoding": {
    "theta": {
     "field": "trips_000",
     "type": "quantitative",
     "stack": true
    },
    "order": {
     "field": "trips_000",
     "type": "quantitative",
     "sort": "descending"
    },
    "text": {
     "field": "share",
     "type": "quantitative",
     "format": ".0f"
    },
    "color": {
     "condition": {
      "test": "datum.reason=='Holiday'",
      "value": "white"
     },
     "value": "#222"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "t": "112.5 million",
      "s": "trips"
     }
    ]
   },
   "mark": {
    "type": "text",
    "fontSize": 30,
    "fontWeight": "bold",
    "dy": -8,
    "color": "#222"
   },
   "encoding": {
    "text": {
     "field": "t"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "t": "overnight trips"
     }
    ]
   },
   "mark": {
    "type": "text",
    "fontSize": 14,
    "dy": 18,
    "color": "#666"
   },
   "encoding": {
    "text": {
     "field": "t"
    }
   }
  }
 ]
}