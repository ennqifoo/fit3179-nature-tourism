{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 520,
 "title": {
  "text": [
   "Four in five regional nature trips go to NSW, Victoria and",
   "Queensland; the Northern Territory has only 7 dots"
  ],
  "subtitle": [
   "Each dot = 100,000 overnight trips by Australian residents to a regional destination in",
   "2024 (capital-city regions excluded). Dots are placed randomly inside each region."
  ],
  "anchor": "start"
 },
 "params": [
  {
   "name": "state_pick",
   "value": "All",
   "bind": {
    "input": "select",
    "name": "State: ",
    "options": [
     "All",
     "NSW",
     "VIC",
     "QLD",
     "SA",
     "WA",
     "TAS",
     "NT",
     "ACT"
    ]
   }
  }
 ],
 "projection": {
  "type": "conicEqualArea",
  "parallels": [
   -18,
   -36
  ],
  "rotate": [
   -134,
   0
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/regions.topojson",
    "format": {
     "type": "topojson",
     "feature": "regions"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#ececec",
    "stroke": "white",
    "strokeWidth": 0.4
   }
  },
  {
   "data": {
    "url": "data/states.topojson",
    "format": {
     "type": "topojson",
     "feature": "states"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": null,
    "stroke": "#777",
    "strokeWidth": 0.6
   }
  },
  {
   "data": {
    "url": "data/dots_trips_2024.csv"
   },
   "transform": [
    {
     "filter": "state_pick == 'All' || datum.state == state_pick"
    }
   ],
   "mark": {
    "type": "circle",
    "size": 22,
    "opacity": 0.75,
    "color": "#6a3d9a"
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "region",
      "title": "Region"
     },
     {
      "field": "state",
      "title": "State"
     },
     {
      "field": "region_trips_2024_000",
      "title": "Region trips 2024 ('000)",
      "format": ",.0f"
     }
    ]
   }
  },
  {
   "data": {
    "values": [
     {
      "lon": 124,
      "lat": -40.5,
      "t": "●  = 100,000 overnight trips"
     }
    ]
   },
   "mark": {
    "type": "text",
    "align": "left",
    "fontSize": 12,
    "color": "#6a3d9a",
    "fontWeight": "bold"
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "text": {
     "field": "t"
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  }
 }
}