{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 625,
 "title": {
  "text": [
   "Regional winners and losers, 2019 versus 2024"
  ],
  "subtitle": [
   "Overnight trips (thousands). The 6 biggest gainers and 6 biggest decliners among",
   "regional destinations with 500,000 or more trips in 2019."
  ],
  "anchor": "start"
 },
 "data": {
  "url": "data/region_slope.csv"
 },
 "transform": [
  {
   "calculate": "datum.region=='Flinders Ranges and Outback' ? 'fall' : datum.region=='North West' ? 'rise' : 'rest'",
   "as": "grp"
  },
  {
   "calculate": "datum.region + ' ' + (datum.change_pct>0?'+':'') + datum.change_pct + '%'",
   "as": "lbl"
  }
 ],
 "layer": [
  {
   "mark": {
    "type": "line",
    "point": {
     "filled": true,
     "size": 50
    }
   },
   "encoding": {
    "x": {
     "field": "year",
     "type": "quantitative",
     "axis": {
      "title": null,
      "labelFontSize": 13,
      "labelAngle": 0,
      "values": [
       2019,
       2024
      ],
      "format": "d",
      "grid": false
     },
     "scale": {
      "domain": [
       2018.8,
       2026.9
      ]
     }
    },
    "y": {
     "field": "trips",
     "type": "quantitative",
     "title": "Overnight trips (thousands)",
     "scale": {
      "zero": false
     }
    },
    "detail": {
     "field": "region"
    },
    "color": {
     "condition": [
      {
       "test": "datum.grp=='fall'",
       "value": "#cb181d"
      },
      {
       "test": "datum.grp=='rise'",
       "value": "#252525"
      }
     ],
     "value": "#bdbdbd"
    },
    "strokeWidth": {
     "condition": {
      "test": "datum.grp=='rest'",
      "value": 1.3
     },
     "value": 3
    },
    "tooltip": [
     {
      "field": "region"
     },
     {
      "field": "year",
      "type": "ordinal"
     },
     {
      "field": "trips",
      "title": "Trips (thousands)"
     },
     {
      "field": "change_pct",
      "title": "Change (%)"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year==2024 && datum.grp=='rise'"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 10,
    "fontSize": 13,
    "fontWeight": "bold",
    "dy": -10
   },
   "encoding": {
    "x": {
     "field": "year",
     "type": "quantitative"
    },
    "y": {
     "field": "trips",
     "type": "quantitative"
    },
    "text": {
     "field": "lbl"
    },
    "color": {
     "condition": {
      "test": "datum.grp=='fall'",
      "value": "#cb181d"
     },
     "value": "#252525"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year==2024 && datum.grp=='fall'"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 10,
    "fontSize": 13,
    "fontWeight": "bold",
    "dy": 10
   },
   "encoding": {
    "x": {
     "field": "year",
     "type": "quantitative"
    },
    "y": {
     "field": "trips",
     "type": "quantitative"
    },
    "text": {
     "field": "lbl"
    },
    "color": {
     "condition": {
      "test": "datum.grp=='fall'",
      "value": "#cb181d"
     },
     "value": "#252525"
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "grid": false
  }
 },
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "padding": {
  "right": 10,
  "left": 5,
  "top": 5,
  "bottom": 5
 }
}