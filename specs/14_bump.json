{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 360,
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "title": {
  "text": [
   "Queensland climbed from 4th to 1st; the Northern Territory",
   "slid from 6th to last"
  ],
  "subtitle": [
   "Rank of each state's trips relative to 2019 (1 = most recovered), 2020–2024"
  ],
  "anchor": "start"
 },
 "data": {
  "url": "data/nvs_state_rank.csv"
 },
 "layer": [
  {
   "mark": {
    "type": "line",
    "point": {
     "size": 90,
     "filled": true
    },
    "interpolate": "monotone"
   },
   "encoding": {
    "x": {
     "field": "year",
     "type": "quantitative",
     "scale": {
      "domain": [
       2019.3,
       2024.7
      ]
     },
     "axis": {
      "format": "d",
      "values": [
       2020,
       2021,
       2022,
       2023,
       2024
      ],
      "title": null,
      "grid": false
     }
    },
    "y": {
     "field": "rank",
     "type": "quantitative",
     "scale": {
      "domain": [
       0.5,
       8.5
      ],
      "reverse": true
     },
     "axis": {
      "values": [
       1,
       2,
       3,
       4,
       5,
       6,
       7,
       8
      ],
      "title": "Rank",
      "grid": false
     }
    },
    "detail": {
     "field": "state"
    },
    "color": {
     "condition": [
      {
       "test": "datum.state=='QLD'",
       "value": "#08519c"
      },
      {
       "test": "datum.state=='NT'",
       "value": "#6baed6"
      }
     ],
     "value": "#bdbdbd"
    },
    "strokeWidth": {
     "condition": [
      {
       "param": "hv",
       "empty": false,
       "value": 6
      },
      {
       "test": "datum.state=='QLD'||datum.state=='NT'",
       "value": 4
      }
     ],
     "value": 2
    },
    "opacity": {
     "condition": [
      {
       "param": "hv",
       "empty": false,
       "value": 1
      },
      {
       "test": "datum.state=='QLD'||datum.state=='NT'",
       "value": 1
      }
     ],
     "value": 0.8
    },
    "tooltip": [
     {
      "field": "state",
      "title": "State"
     },
     {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
     },
     {
      "field": "rank",
      "title": "Rank"
     },
     {
      "field": "index_2019",
      "title": "Index (2019=100)"
     }
    ]
   },
   "params": [
    {
     "name": "hv",
     "select": {
      "type": "point",
      "fields": [
       "state"
      ],
      "on": "mouseover",
      "clear": "mouseout"
     }
    }
   ]
  },
  {
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 10,
    "fontWeight": "bold",
    "fontSize": 13
   },
   "transform": [
    {
     "filter": "datum.year==2024"
    }
   ],
   "encoding": {
    "x": {
     "field": "year",
     "type": "quantitative"
    },
    "y": {
     "field": "rank",
     "type": "quantitative"
    },
    "text": {
     "field": "state"
    },
    "color": {
     "condition": [
      {
       "test": "datum.state=='QLD'",
       "value": "#08519c"
      },
      {
       "test": "datum.state=='NT'",
       "value": "#6baed6"
      }
     ],
     "value": "#757575"
    }
   }
  },
  {
   "mark": {
    "type": "text",
    "align": "right",
    "dx": -10,
    "fontWeight": "bold",
    "fontSize": 13
   },
   "transform": [
    {
     "filter": "datum.year==2020"
    }
   ],
   "encoding": {
    "x": {
     "field": "year",
     "type": "quantitative"
    },
    "y": {
     "field": "rank",
     "type": "quantitative"
    },
    "text": {
     "field": "state"
    },
    "color": {
     "condition": [
      {
       "test": "datum.state=='QLD'",
       "value": "#08519c"
      },
      {
       "test": "datum.state=='NT'",
       "value": "#6baed6"
      }
     ],
     "value": "#757575"
    }
   }
  }
 ]
}