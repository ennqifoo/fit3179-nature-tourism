{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 470,
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "title": {
  "text": [
   "Transport, accommodation and food take 83% of",
   "visitor spending"
  ],
  "subtitle": [
   "Domestic overnight trip spending, year ending June 2026. Colour = spending",
   "group; rectangle area = dollars spent."
  ],
  "anchor": "start"
 },
 "data": {
  "url": "data/spend_treemap.csv"
 },
 "transform": [
  {
   "calculate": "datum.item+' '+format(datum.share,'.0f')+'%'",
   "as": "txt"
  },
  {
   "calculate": "datum.wrap==1 ? split(datum.txt,' ') : datum.txt",
   "as": "lbl"
  }
 ],
 "encoding": {
  "x": {
   "field": "x0",
   "type": "quantitative",
   "scale": {
    "domain": [
     0,
     100
    ]
   },
   "axis": null
  },
  "x2": {
   "field": "x1"
  },
  "y": {
   "field": "y0",
   "type": "quantitative",
   "scale": {
    "domain": [
     0,
     60
    ],
    "reverse": true
   },
   "axis": null
  },
  "y2": {
   "field": "y1"
  }
 },
 "layer": [
  {
   "transform": [
    {
     "filter": "datum.level=='group'"
    }
   ],
   "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 4
   },
   "encoding": {
    "color": {
     "field": "group",
     "type": "nominal",
     "scale": {
      "domain": [
       "Transport",
       "Accommodation",
       "Food and drink",
       "Shopping and leisure",
       "Other"
      ],
      "range": [
       "#b34700",
       "#0b5c8f",
       "#00795a",
       "#9c3f7f",
       "#5c5c5c"
      ]
     },
     "legend": {
      "title": "Spending group",
      "orient": "bottom",
      "symbolType": "square",
      "symbolSize": 180,
      "columns": 3,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelLimit": 240
     }
    },
    "tooltip": [
     {
      "field": "group",
      "title": "Group"
     },
     {
      "field": "spend_m",
      "title": "Spend ($ million)",
      "format": ","
     },
     {
      "field": "share",
      "title": "Share of spending (%)",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.level=='item'"
    }
   ],
   "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
   },
   "encoding": {
    "color": {
     "field": "fill",
     "type": "nominal",
     "scale": null,
     "legend": null
    },
    "opacity": {
     "condition": {
      "param": "hv",
      "empty": false,
      "value": 1
     },
     "value": 0.85
    },
    "tooltip": [
     {
      "field": "group",
      "title": "Group"
     },
     {
      "field": "item",
      "title": "Item"
     },
     {
      "field": "spend_m",
      "title": "Spend ($ million)",
      "format": ","
     },
     {
      "field": "share",
      "title": "Share of spending (%)",
      "format": ".1f"
     }
    ]
   },
   "params": [
    {
     "name": "hv",
     "select": {
      "type": "point",
      "fields": [
       "item"
      ],
      "on": "mouseover",
      "clear": "mouseout"
     }
    }
   ]
  },
  {
   "transform": [
    {
     "filter": "datum.level=='group'"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "dx": 8,
    "fontSize": 14,
    "fontWeight": "bold",
    "color": "white"
   },
   "encoding": {
    "x": {
     "field": "x0",
     "type": "quantitative"
    },
    "y": {
     "field": "cy",
     "type": "quantitative"
    },
    "text": {
     "field": "lbl"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.level=='item' && datum.show_label==1"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#1f2933",
    "lineHeight": 15
   },
   "encoding": {
    "x": {
     "field": "cx",
     "type": "quantitative"
    },
    "y": {
     "field": "cy",
     "type": "quantitative"
    },
    "text": {
     "field": "lbl"
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  }
 }
}